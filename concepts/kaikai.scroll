example
 effect Log {
   log(msg: String) : Unit
 }
 
 fn greet(name: String) : Unit / Log {
   Log.log("hello, #{name}")
 }
 
 fn main() {
   handle {
     greet("world")
   } with Log {
     log(msg, resume) -> {
       println("[INFO] #{msg}")
       resume(())
     }
   }
 }

