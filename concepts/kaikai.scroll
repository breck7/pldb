hasFunctions true
 fn add(a: Int, b: Int) : Int = a + b
hasStaticTyping true
 fn add(a: Int, b: Int) : Int = a + b
hasTypeInference true
 let answer = 42
hasAlgebraicTypes true
 type Tag
   = Both
   | Fizz
   | Buzz
   | Other(Int)
hasPatternMatching true
 fn classify(n: Int) : Tag = match n {
   n if n % 15 == 0 -> Both
   n if n % 3 == 0 -> Fizz
   n if n % 5 == 0 -> Buzz
   n -> Other(n)
 }
hasPipes true
 [1..100]
   | classify
   | label
   |> list.foreach(println)
