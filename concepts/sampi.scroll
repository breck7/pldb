example
 set x to 2
 glue pi to 3.14
 
 if x = 0:
   say("x is 0")
 else if x > 0:
   say("x is positive!")
 else:
   say("x is negative!")
 end
 
 repeat 5:
   say("hello")
 end
 
 repeat 5 as i:
   say(i)
 end
 
 func add a b:
  return a + b
 end
 
 say(add(2, 3))

githubRepo https://github.com/legospider15/Sampi
 description Sampi is a dynamically typed language with a small set of keywords, designed to be easy to learn.

hasLineComments true
 // comment
hasMultilineComments yes
 # comment #
hasStrings true
hasIntegers true
hasFloats true
hasBooleans true
 true false
hasFunctions true
hasClasses true
hasConditionals true
hasWhileLoops yes
 by using until not
hasExceptions partial
hasStaticTyping false
hasZeroBasedIndexing false
 1 based indexing
hasBitWiseOperators false
hasTernaryOperators false
