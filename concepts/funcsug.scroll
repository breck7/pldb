hasLists true
 myParallelList := |1, 2, 3, 4, 5|
hasSemanticIndentation true

isOpenSource true
example
 parallel exitAfter 1 finished:
 	while true:
 		waitSeconds(2)
 		displayNewMessage('Hello, World!')
 	awaitClick('#stop')

