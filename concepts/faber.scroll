stringToken "

hasPrintDebugging true
 print "Hello world"
hasStrings true
 "Hello world"
hasComments true
 # A comment
hasLineComments true
 # A comment
hasSemanticIndentation false
hasIntegers true
 let int answer ← 42
hasFunctions true
 fn add(int a, int b) → int {
     return a + b
 }
hasStaticTyping true
 fn add(int a, int b) → int {
     return a + b
 }
hasTypeInference true
 let _ answer ← 42
hasGenerics true
 fn first<T>(list<T> items, T fallback) → T {
     return items.get(0) coalesce fallback
 }
hasExceptions true
 fn divide(int a, int b) → int ⇥ string {
     if b ≡ 0 then throw "division by zero"
     return a / b
 }
hasBooleans true
 let bool ready ← true
hasLists true
 let list<int> xs ← [1, 2, 3]
hasAssignment true
 mut int n ← 0
 n ← n + 1
hasWhileLoops true
 while n ≺ 3 {
     n ← n + 1
 }
hasConditionals true
 if ready {
     print xs[0]
 }
hasImports true
 import from "norma:text"
hasZeroBasedNumbering true
 print xs[0]
