{
  "name": "scrollsdk",
  "version": "108.0.0",
  "description": "This SDK includes the Particles class, the Parsers compiler-compiler, a Parsers IDE, and more, all implemented in Particles, Parsers, and TypeScript.",
  "main": "./products/Particle.js",
  "prettier": {
    "parser": "babel",
    "useTabs": false,
    "tabWidth": 2,
    "semi": false,
    "printWidth": 240,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "quoteProps": "as-needed"
  },
  "files": [
    "products/Disk.node.js",
    "products/parsers.nodejs.js",
    "products/ParsersCompiler.js",
    "products/Parsers.js",
    "products/hakon.nodejs.js",
    "products/stamp.nodejs.js",
    "products/stump.nodejs.js",
    "products/swarm.nodejs.js",
    "products/TestRacer.js",
    "products/ScrollFileSystem.js",
    "products/Particle.js",
    "products/Utils.js"
  ],
  "engineStrict": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "local": "node ./products/Kitchen.node.js",
    "updateVersion": "./builder.ts updateVersion",
    "test": "ts-node builder.ts test",
    "cloc": "cloc $(git ls-files | grep --extended-regexp --invert-match 'products|lib|package-lock')",
    "checkLinks": "linkinator -r https://sdk.scroll.surf",
    "coverage": "tap --cov --coverage-report=lcov ${__filename} test",
    "buildDocs": "scroll list | scroll build",
    "buildSdk": "ts-node builder.ts produceAll && ts-node builder.ts produceAllLangs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/breck7/scrollsdk.git"
  },
  "keywords": "scroll",
  "devDependencies": {
    "@types/codemirror": "^5.60.7",
    "@types/node": "^18.15.11",
    "express": "^4.18.2",
    "prettier": "^2.8.8",
    "scroll-cli": "github:breck7/scroll",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.3"
  },
  "overrides": {
    "scroll-cli": "$scroll-cli",
    "scrollsdk": "github:breck7/scrollsdk"
  }
}
